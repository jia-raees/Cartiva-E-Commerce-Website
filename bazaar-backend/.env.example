# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/bazaar
# Atlas:      mongodb+srv://<user>:<password>@<cluster-url>/bazaar?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/bazaar

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - the origin(s) your frontend runs on, comma separated
CLIENT_ORIGIN=http://localhost:5173

